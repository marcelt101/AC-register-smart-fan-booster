  (text "POWER STAGE: Q1 switches at 40 kHz, L1 + C3 filter it to DC across the fans." (at 129.54 33.02 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid d1d22861-3061-44d4-8b5e-68221e44f8af))
