  (text "POWER STAGE: GP15 PWM 40 kHz -> R1 -> Q1. L1 + C3 filter it to DC across the fans." (at 165.1 45.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 5922e487-51c3-4dbd-a45a-2b78e3ce17a9))
